# Скопируйте этот файл в .env и при необходимости заполните значения.
DEBUG=True
# Обязателен при DEBUG=False. При DEBUG=True ключ создаётся автоматически при запуске.
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
# Для PostgreSQL: DB_ENGINE=postgresql и pip install -r requirements-postgres.txt
DB_NAME=sms_guard
DB_USER=sms_guard
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# True только при работе через HTTPS: включает Secure у cookie.
HTTPS_ONLY=False
