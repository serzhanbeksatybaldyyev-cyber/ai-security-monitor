digraph ER {
graph [rankdir=LR, fontname="DejaVu Sans", nodesep=0.5, ranksep=1.1, label="ER-диаграмма базы данных SMS Guard (построена из моделей Django)", labelloc=t, fontsize=18];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=11];
edge [fontname="DejaVu Sans", fontsize=10, color="#47586a", arrowhead=none];
"auth_user" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#e8eef6"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>auth_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#555555">Auto</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password_in"> </TD><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT" PORT="password_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_login_in"> </TD><TD ALIGN="LEFT">last_login</TD><TD ALIGN="LEFT" PORT="last_login_out"><FONT COLOR="#555555">DateTime NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_superuser_in"> </TD><TD ALIGN="LEFT">is_superuser</TD><TD ALIGN="LEFT" PORT="is_superuser_out"><FONT COLOR="#555555">Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="username_in"> </TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT" PORT="username_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email_in"> </TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT" PORT="email_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_staff_in"> </TD><TD ALIGN="LEFT">is_staff</TD><TD ALIGN="LEFT" PORT="is_staff_out"><FONT COLOR="#555555">Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active_in"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT" PORT="is_active_out"><FONT COLOR="#555555">Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_joined_in"> </TD><TD ALIGN="LEFT">date_joined</TD><TD ALIGN="LEFT" PORT="date_joined_out"><FONT COLOR="#555555">DateTime</FONT></TD></TR></TABLE>>];
"user_profile" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>user_profile</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#555555">BigInt</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id_in"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT" PORT="user_id_out"><FONT COLOR="#555555">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="store_sms_text_in"> </TD><TD ALIGN="LEFT">store_sms_text</TD><TD ALIGN="LEFT" PORT="store_sms_text_out"><FONT COLOR="#555555">Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="preferred_language_in"> </TD><TD ALIGN="LEFT">preferred_language</TD><TD ALIGN="LEFT" PORT="preferred_language_out"><FONT COLOR="#555555">Char</FONT></TD></TR></TABLE>>];
"checks" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>checks</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#555555">BigInt</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id_in"><B>FK</B></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT" PORT="user_id_out"><FONT COLOR="#555555">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="check_type_in"> </TD><TD ALIGN="LEFT">check_type</TD><TD ALIGN="LEFT" PORT="check_type_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="input_text_in"> </TD><TD ALIGN="LEFT">input_text</TD><TD ALIGN="LEFT" PORT="input_text_out"><FONT COLOR="#555555">Text NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="input_masked_in"> </TD><TD ALIGN="LEFT">input_masked</TD><TD ALIGN="LEFT" PORT="input_masked_out"><FONT COLOR="#555555">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="language_in"> </TD><TD ALIGN="LEFT">language</TD><TD ALIGN="LEFT" PORT="language_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_in"> </TD><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT" PORT="category_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="risk_level_in"> </TD><TD ALIGN="LEFT">risk_level</TD><TD ALIGN="LEFT" PORT="risk_level_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="risk_score_in"> </TD><TD ALIGN="LEFT">risk_score</TD><TD ALIGN="LEFT" PORT="risk_score_out"><FONT COLOR="#555555">SmallInt</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="p_sms_in"> </TD><TD ALIGN="LEFT">p_sms</TD><TD ALIGN="LEFT" PORT="p_sms_out"><FONT COLOR="#555555">Float NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="explanation_in"> </TD><TD ALIGN="LEFT">explanation</TD><TD ALIGN="LEFT" PORT="explanation_out"><FONT COLOR="#555555">JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="recommendation_in"> </TD><TD ALIGN="LEFT">recommendation</TD><TD ALIGN="LEFT" PORT="recommendation_out"><FONT COLOR="#555555">Text</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sms_model_version_id_in"><B>FK</B></TD><TD ALIGN="LEFT">sms_model_version_id</TD><TD ALIGN="LEFT" PORT="sms_model_version_id_out"><FONT COLOR="#555555">FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="url_model_version_id_in"><B>FK</B></TD><TD ALIGN="LEFT">url_model_version_id</TD><TD ALIGN="LEFT" PORT="url_model_version_id_out"><FONT COLOR="#555555">FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_in"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#555555">DateTime</FONT></TD></TR></TABLE>>];
"url_results" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>url_results</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#555555">BigInt</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="check_id_in"><B>FK</B></TD><TD ALIGN="LEFT">check_id</TD><TD ALIGN="LEFT" PORT="check_id_out"><FONT COLOR="#555555">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="url_in"> </TD><TD ALIGN="LEFT">url</TD><TD ALIGN="LEFT" PORT="url_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="domain_in"> </TD><TD ALIGN="LEFT">domain</TD><TD ALIGN="LEFT" PORT="domain_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="p_url_in"> </TD><TD ALIGN="LEFT">p_url</TD><TD ALIGN="LEFT" PORT="p_url_out"><FONT COLOR="#555555">Float</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_in"> </TD><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT" PORT="category_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="risk_score_in"> </TD><TD ALIGN="LEFT">risk_score</TD><TD ALIGN="LEFT" PORT="risk_score_out"><FONT COLOR="#555555">SmallInt</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="features_json_in"> </TD><TD ALIGN="LEFT">features_json</TD><TD ALIGN="LEFT" PORT="features_json_out"><FONT COLOR="#555555">JSON</FONT></TD></TR></TABLE>>];
"detected_features" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>detected_features</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#555555">BigInt</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="check_id_in"><B>FK</B></TD><TD ALIGN="LEFT">check_id</TD><TD ALIGN="LEFT" PORT="check_id_out"><FONT COLOR="#555555">FK</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="code_in"> </TD><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT" PORT="code_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title_in"> </TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT" PORT="title_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="weight_in"> </TD><TD ALIGN="LEFT">weight</TD><TD ALIGN="LEFT" PORT="weight_out"><FONT COLOR="#555555">Float</FONT></TD></TR></TABLE>>];
"model_versions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ffffff"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>model_versions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#555555">BigInt</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model_type_in"> </TD><TD ALIGN="LEFT">model_type</TD><TD ALIGN="LEFT" PORT="model_type_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="version_in"> </TD><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT" PORT="version_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="algorithm_in"> </TD><TD ALIGN="LEFT">algorithm</TD><TD ALIGN="LEFT" PORT="algorithm_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="metrics_json_in"> </TD><TD ALIGN="LEFT">metrics_json</TD><TD ALIGN="LEFT" PORT="metrics_json_out"><FONT COLOR="#555555">JSON</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="threshold_in"> </TD><TD ALIGN="LEFT">threshold</TD><TD ALIGN="LEFT" PORT="threshold_out"><FONT COLOR="#555555">Float</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="trained_at_in"> </TD><TD ALIGN="LEFT">trained_at</TD><TD ALIGN="LEFT" PORT="trained_at_out"><FONT COLOR="#555555">DateTime NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_active_in"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT" PORT="is_active_out"><FONT COLOR="#555555">Boolean</FONT></TD></TR></TABLE>>];
"admin_actions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#efe7fa"><TR><TD COLSPAN="3" BGCOLOR="#17324d"><FONT COLOR="white"><B>admin_actions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT" PORT="id_out"><FONT COLOR="#555555">BigInt</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="actor_id_in"><B>FK</B></TD><TD ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT" PORT="actor_id_out"><FONT COLOR="#555555">FK NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="action_in"> </TD><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT" PORT="action_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="target_in"> </TD><TD ALIGN="LEFT">target</TD><TD ALIGN="LEFT" PORT="target_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="details_in"> </TD><TD ALIGN="LEFT">details</TD><TD ALIGN="LEFT" PORT="details_out"><FONT COLOR="#555555">Char</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_in"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_out"><FONT COLOR="#555555">DateTime</FONT></TD></TR></TABLE>>];
"user_profile":"user_id_out":e -> "auth_user":"id_in":w [label="1 : 1"];
"checks":"user_id_out":e -> "auth_user":"id_in":w [label="N : 1"];
"checks":"sms_model_version_id_out":e -> "model_versions":"id_in":w [label="N : 1"];
"checks":"url_model_version_id_out":e -> "model_versions":"id_in":w [label="N : 1"];
"url_results":"check_id_out":e -> "checks":"id_in":w [label="N : 1"];
"detected_features":"check_id_out":e -> "checks":"id_in":w [label="N : 1"];
"admin_actions":"actor_id_out":e -> "auth_user":"id_in":w [label="N : 1"];
}